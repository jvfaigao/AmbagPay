# Copy to .env.local and fill. Public values only (anything VITE_ is visible in the browser).

# 97 = BSC Testnet, 31337 = local Hardhat node
VITE_CHAIN_ID=97
VITE_VAULT_ADDRESS=
VITE_TOKEN_ADDRESS=
VITE_DEMO_COLLECTION_ID=0

# Privy dashboard -> App ID (Google login on, http://localhost:5173 in allowed origins)
VITE_PRIVY_APP_ID=

# Optional: override the RPC URL
VITE_RPC_URL=


# --- Server only (web/api/*). Set these in Vercel too. Never prefix with VITE_ ---
# CHAIN_ID=97
# RPC_URL=
# TOKEN_ADDRESS=
# FAUCET_PRIVATE_KEY=     # deployer = owner of MockPHP
# VAULT_ADDRESS=
# AGENT_PRIVATE_KEY=      # wallet with AGENT_ROLE only
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # flash hit the free quota on Nov 12; 3.7/3.8 timed out
# FIREBASE_SERVICE_ACCOUNT=   # service account JSON on one line
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

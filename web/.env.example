# Copy to .env.local and fill. Public values only (anything VITE_ is visible in the browser).

# 97 = BSC Testnet, 31337 = local Hardhat node
VITE_CHAIN_ID=97
VITE_VAULT_ADDRESS=
VITE_TOKEN_ADDRESS=
VITE_DEMO_COLLECTION_ID=0

# Privy dashboard -> App ID (Google login on, http://localhost:5173 in allowed origins)
VITE_PRIVY_APP_ID=

# Optional: override the RPC URL
VITE_RPC_URL=


# --- Server only (web/api/*). Set these in Vercel too. Never prefix with VITE_ ---
# CHAIN_ID=97
# RPC_URL=
# TOKEN_ADDRESS=
# FAUCET_PRIVATE_KEY=     # deployer = owner of MockPHP
